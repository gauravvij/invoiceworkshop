# Public analytics identifier. Never put document/customer data in events.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Level-1A stays off unless this and the separately owner-approved DB switch are true.
LEVEL1_OUTBOUND_ENABLED=false

# Non-secret Zoho regional API configuration. Tokens must be provided by a file
# outside this repository; see docs/LEVEL1A_SAFETY_READINESS.md.
ZOHO_MAIL_API_BASE=https://mail.zoho.in/api
ZOHO_MAIL_ACCOUNT_ID=
