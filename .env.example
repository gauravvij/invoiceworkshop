# Public analytics identifier. Never put document/customer data in events.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Level-1A stays off unless this and the separately owner-approved DB switch are true.
LEVEL1_OUTBOUND_ENABLED=false

# The OAuth file contains secrets and must remain outside Git with mode 600.
ZOHO_OAUTH_SECRET_FILE=/secure/path/to/zoho_oauth.json

# Backlink discovery search provider. Options: anysearch (default), bing_rss.
# There is no fallback: if the configured provider fails, discovery reports the
# failure rather than quietly using a weaker source. bing_rss is retained only
# for comparison — it ignores site: and quoted-phrase operators.
BACKLINK_SEARCH_PROVIDER=anysearch

# Optional. AnySearch works anonymously; set this only if a key is issued.
ANYSEARCH_API_KEY=
