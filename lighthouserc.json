{
  "ci": {
    "collect": {
      "startServerCommand": "npx serve dist -l 4321",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/proforma-invoice-generator/",
        "http://127.0.0.1:4321/quotation-generator/",
        "http://127.0.0.1:4321/work-order-generator/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lighthouse-reports" }
  }
}
